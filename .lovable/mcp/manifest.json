{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://huyukwakzepeiffslijm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sentinel-shield",
      "version": "0.1.0",
      "title": "Sentinel Shield"
    },
    "tools": [
      {
        "name": "search_providers",
        "title": "Search providers",
        "description": "Find active care providers by specialty or name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Specialty or name to match.",
              "type": "string",
              "maxLength": 80
            },
            "telemedicine_only": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_my_appointments",
        "title": "List my appointments",
        "description": "List the signed-in user's appointments, optionally only upcoming ones.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "upcoming_only": {
              "description": "Only return future appointments.",
              "type": "boolean"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
